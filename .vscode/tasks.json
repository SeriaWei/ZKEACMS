{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Build the ZKEACMS solution"
        },
        {
            "label": "run",
            "command": "dotnet",
            "type": "process",
            "dependsOn": "build",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/src/ZKEACMS.WebHost/ZKEACMS.WebHost.csproj"
            ],
            "problemMatcher": "$msCompile",
            "isBackground": true,
            "detail": "Run the ZKEACMS WebHost, listening on: http://localhost:5000"
        }
    ]
}